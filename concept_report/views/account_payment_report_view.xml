<odoo>
    <record id="view_account_payment_report_v2_tree" model="ir.ui.view">
        <field name="name">account.payment.report.v2.tree</field>
        <field name="model">account.payment.report.v2</field>
        <field name="arch" type="xml">
            <tree string="Account Payment Report V2" create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="journal_id"/>
                <field name="partner_id"/>
                <field name="move_id" string="Payment Number"  widget="many2one_clickable"/>
                <field name="payment_id" string="Payment Number" widget="many2one_clickable"/>
                <field name="debit" widget="float" digits="[16, 3]"/>
                <field name="credit" widget="float" digits="[16, 3]"/>
                <field name="company_id"/>
                <field name="ref" optional="hide"/>
                <field name="bank_reference" optional="hide"/>
                <field name="cheque_reference" optional="hide"/>
                
            </tree>
        </field>
    </record>

    <record id="view_account_payment_report_v2_search" model="ir.ui.view">
        <field name="name">account.payment.report.v2.search</field>
        <field name="model">account.payment.report.v2</field>
        <field name="arch" type="xml">
            <search>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="partner_id"/>
                <field name="move_id" string="Payment Number"/>

                <filter name="filter_posted" string="Posted" domain="[('parent_state', '=', 'posted')]"/>
                <filter name="filter_draft" string="Draft" domain="[('parent_state', '=', 'draft')]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('date', '=', context_today())]"/>
                <filter name="yesterday" string="Yesterday" domain="[('date', '=', (context_today() - relativedelta(days=1)))]"/> 
                <filter name="this_month" string="This Month" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01')), ('date', '&lt;=', context_today())]" /> 
                <separator/>
                <filter name="customer_payments" string="Customer Payments" domain="[('partner_type', '=', 'customer')]"/>
                <filter name="vendor_payments" string="Vendor Payments" domain="[('partner_type', '=', 'supplier')]"/>
                <separator/>
                <filter name="filter_date" string="Date" date="date"/>

                <group expand="0" string="Group By">
                    <filter name="group_by_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
                    <filter name="group_by_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <separator/>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <separator/>
                    <filter name="group_by_due_date" string="Due Date" context="{'group_by': 'due_date'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_account_payment_report_v2" model="ir.actions.act_window">
        <field name="name">Account Payment Report</field>
        <field name="res_model">account.payment.report.v2</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_account_payment_report_v2_search"/>
        <field name="context">{'search_default_filter_posted': 1, 'group_by': 'journal_id'}</field>
        <field name="domain">[('company_id', 'in', context.get('allowed_company_ids', []))]</field>
    </record>

    <menuitem id="menu_account_payment_report_v2"
              name="Payment Report"
              parent="concept_account_reports.menu_concept_account_root"
              action="action_account_payment_report_v2"/>
</odoo>
